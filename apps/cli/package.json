{
  "name": "@keepsake/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile src/app/cli.ts --outfile dist/keepsake",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:a11y": "a11y-playwright",
    "install:user": "bun run build && bun scripts/install.ts"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.1.5",
    "@effect/ai-openai-compat": "4.1.5",
    "@effect/platform-bun": "4.1.5",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@davidvornholt/a11y-testing": "workspace:*",
    "@davidvornholt/typescript-config": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/bun": "^1.4.3",
    "typescript": "7.0.2"
  }
}
